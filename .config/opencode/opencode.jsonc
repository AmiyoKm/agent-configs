{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "crtk": {
      "type": "local",
      "command": [
        "/home/amiyo/code-review-tribal-knowledge/.venv/bin/crtk",
        "--config",
        "/home/amiyo/code-review-tribal-knowledge/crtk.toml",
        "serve"
      ]
    }
  },
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "${TOKENROUTER_API_KEY}"
      },
      "models": {
        "glm-5.3-free": {
          "name": "GLM 5.3 Free",
          "id": "z-ai/glm-5.3-free"
        },
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 Free"
        }
      }
    }
  }
}